{
  "manifest_version": 2,
  "name": "AI Digital Bodyguard",
  "version": "1.0.0",
  "description": "Real-time website security scanning powered by AI Digital Bodyguard",
  "permissions": ["activeTab", "storage", "tabs", "webNavigation", "<all_urls>"],
  "browser_action": {
    "default_popup": "popup.html",
    "default_icon": "icon.png"
  },
  "background": {
    "scripts": ["background.js"],
    "persistent": false
  },
  "content_scripts": [{
    "matches": ["<all_urls>"],
    "js": ["content.js"],
    "run_at": "document_idle"
  }]
}
