{
  "manifest_version": 3,
  "name": "AI Digital Bodyguard",
  "version": "1.0.0",
  "description": "Real-time website security scanning powered by AI Digital Bodyguard",
  "permissions": ["activeTab", "storage", "tabs", "webNavigation"],
  "host_permissions": ["http://127.0.0.1:8000/*", "<all_urls>"],
  "action": {
    "default_popup": "popup.html",
    "default_icon": "icon.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [{
    "matches": ["<all_urls>"],
    "js": ["content.js"],
    "run_at": "document_idle"
  }]
}
